<Window x:Class="NewAPP.View.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewAPP.View"
        mc:Ignorable="d"
        Title="📜 История операций" 
        Height="450" 
        Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#2C3E50"
        ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с названием товара -->
        <Border Grid.Row="0" 
                Background="#34495E" 
                CornerRadius="8" 
                Padding="15" 
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📜 ИСТОРИЯ ОПЕРАЦИЙ" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="#3498DB" 
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="ProductNameText" 
                           FontSize="14" 
                           Foreground="White" 
                           HorizontalAlignment="Center" 
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Таблица истории -->
        <DataGrid Grid.Row="1" 
                  x:Name="HistoryDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="#34495E"
                  RowBackground="#2C3E50"
                  Foreground="White"
                  FontSize="12"
                  BorderBrush="#4A6572"
                  BorderThickness="1"
                  HeadersVisibility="Column">

            <DataGrid.Columns>
                <!-- Тип операции с цветом -->
                <DataGridTextColumn Header="Тип операции" 
                                    Width="120" 
                                    Binding="{Binding OperationType}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground">
                                <Setter.Value>
                                    <Binding Path="OperationType">
                                        
                                    </Binding>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Количество" 
                                    Width="100" 
                                    Binding="{Binding Quantity}"/>

                <DataGridTextColumn Header="Дата и время" 
                                    Width="180" 
                                    Binding="{Binding OperationDate, StringFormat='dd.MM.yyyy HH:mm:ss'}"/>

                <DataGridTextColumn Header="Пользователь" 
                                    Width="150" 
                                    Binding="{Binding UserName}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
