<Window x:Class="NewAPP.View.AddNomenclatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewAPP.View"
        mc:Ignorable="d"
        Title="AddNomenclatureWindow"
         Height="650" 
        Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#2C3E50">

    <Window.Resources>
        <!-- Простой стиль для TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="BorderBrush" Value="#4A6572"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#3498DB"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для заголовков полей -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Стиль для кнопки -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#2C3E50" CornerRadius="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Border Grid.Row="0" Background="#34495E" CornerRadius="8" Padding="20" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="📦 ДОБАВЛЕНИЕ НОВОЙ ПОЗИЦИИ" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#3498DB"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Заполните все поля для добавления товара в номенклатуру" 
                                   FontSize="12" 
                                   Foreground="#BDC3C7"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Основные поля (2 колонки) -->
                <Grid Grid.Row="1" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ========== ЛЕВАЯ КОЛОНКА ========== -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📝 НАИМЕНОВАНИЕ" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NameNomenclatureBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                        <TextBlock Text="🔢 ВНЕШНИЙ НОМЕР" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="InterNomenclatureBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                        <TextBlock Text="🔢 ВНУТРЕННИЙ НОМЕР" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ExterNomenclatureBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                        <TextBlock Text="⚙️ ХАРАКТЕРИСТИКА" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="CharNomenclatureBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                        <TextBlock Text="🔖 СЕРИЙНЫЙ НОМЕР" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SNNomenclatureBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                        <TextBlock Text="💰 ЦЕНА ЗА ЕДИНИЦУ" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UnitPriceBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>

                        <TextBlock Text="💰 ВЕС ЕДИНИЦЫ" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="WeightUnitBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15"/>
                    </StackPanel>

                    <!-- ========== ПРАВАЯ КОЛОНКА ========== -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="📏 ЕДИНИЦА ИЗМЕРЕНИЯ" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UnitNomenclatureBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15" Text="шт"/>

                        <TextBlock Text="📍 АДРЕС ЯЧЕЙКИ" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="AdrNomenclatureBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15" Text="1-1-1"/>

                        <TextBlock Text="📊 БЫЛО (НАЧАЛЬНОЕ)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="OldNomenclatureBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15" Text="0"/>

                        <TextBlock Text="➕ ДОБАВИЛИ" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="InNomenclatureBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15" Text="0"/>

                        <TextBlock Text="➖ УБРАЛИ" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="OutNomenclatureBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15" Text="0"/>

                        <TextBlock Text="📦 ОСТАТОК" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NewNomenclatureBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15" Text="0"/>
                    </StackPanel>
                </Grid>

                <!-- Кнопки -->
                <Border Grid.Row="2" Background="#34495E" CornerRadius="8" Padding="20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="AddNumButton" 
                                Content="✅ ДОБАВИТЬ" 
                                Style="{StaticResource ModernButton}"
                                Background="#27AE60" 
                                Foreground="White"
                                Command="{Binding AddNumButton1}"
                                Margin="0,0,15,0"/>

                        <Button x:Name="CancelButton" 
                                Content="❌ ОТМЕНА" 
                                Style="{StaticResource ModernButton}"
                                Background="#E74C3C" 
                                Foreground="White"
                                />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Border>
</Window>
