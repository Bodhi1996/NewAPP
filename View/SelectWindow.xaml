<Window x:Class="NewAPP.View.SelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewAPP.View"
        mc:Ignorable="d"
        Title="Выбор товаров" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#2C3E50">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3498DB"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="#4A6572"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#4A6572"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#34495E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: Доступные товары -->
        <Border Grid.Column="0" Background="#34495E" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="📦 Доступные товары" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                <TextBox x:Name="SearchTextBox" Grid.Row="1" Margin="0,0,0,10" TextChanged="SearchTextBox_TextChanged"/>
                <ListBox x:Name="AvailableListBox" Grid.Row="2" SelectionMode="Extended" DisplayMemberPath="Name"
                         SelectionChanged="AvailableListBox_SelectionChanged" Margin="0,0,0,10"/>
                <TextBlock x:Name="AvailableCountText" Grid.Row="3" Foreground="#7F8C8D" FontSize="11"/>
            </Grid>
        </Border>

        <!-- КНОПКИ -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button x:Name="AddSelectedButton" Style="{StaticResource ActionButtonStyle}" Content="▶" 
                    Click="AddSelectedButton_Click" ToolTip="Добавить выбранные"/>
            <Button x:Name="AddAllButton" Style="{StaticResource ActionButtonStyle}" Content="▶▶" 
                    Click="AddAllButton_Click" ToolTip="Добавить все"/>
            <Button x:Name="RemoveSelectedButton" Style="{StaticResource ActionButtonStyle}" Content="◀" 
                    Click="RemoveSelectedButton_Click" ToolTip="Удалить выбранные"/>
            <Button x:Name="RemoveAllButton" Style="{StaticResource ActionButtonStyle}" Content="◀◀" 
                    Click="RemoveAllButton_Click" ToolTip="Удалить все"/>
        </StackPanel>

        <!-- ПРАВАЯ ПАНЕЛЬ: Выбранные товары -->
        <Border Grid.Column="2" Background="#34495E" CornerRadius="8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="✅ Выбранные товары" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="SelectedCountText" Foreground="#3498DB" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
                <ListBox x:Name="SelectedListBox" Grid.Row="1" SelectionMode="Extended" DisplayMemberPath="Name"
                         SelectionChanged="SelectedListBox_SelectionChanged" Margin="0,0,0,10"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Content="✅ OK" Width="80" Height="35" Margin="5" 
                            Background="#27AE60" Foreground="White" FontWeight="Bold" Click="OkButton_Click"/>
                    <Button x:Name="CancelButton" Content="❌ Отмена" Width="80" Height="35" Margin="5" 
                            Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
