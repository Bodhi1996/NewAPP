<Window x:Class="NewAPP.View.SetSkladWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NewAPP.View"
        mc:Ignorable="d"
        Title="SetSkladWindow" Height="300" Width="500">
    <Grid Background="#2C3E50">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <TextBlock Text="Размещение стелажа склада" FontSize="20" FontWeight="Bold"/>
        </StackPanel>
        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="Кол-во рядов" FontSize="18" FontWeight="Bold"/> <!--Row наименование-->
                <TextBox x:Name="RowBox" Margin="10,10,120,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="Кол-во стелажей" FontSize="18" FontWeight="Bold"/> <!--Shelf наименование-->
                <TextBox x:Name="ShelfBox" Margin="10,10,120,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0">
                <TextBlock Text="Кол-во ячеек" FontSize="18" FontWeight="Bold"/> <!--Cell наименование-->
                <TextBox x:Name="CellBox" Margin="10,10,120,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1">
                <Button x:Name="SkladButton" Content="Добавить" HorizontalAlignment="Center" Width="100" Height="50" Command="{Binding SkladCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
